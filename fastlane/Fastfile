# frozen_string_literal: true

require "digest"
require "open3"
require "shellwords"
require "tmpdir"

default_platform(:android)

APP_ID = "com.notes.easynotebook"
ALLOWED_RELEASE_BRANCHES = %w[main].freeze
EXPECTED_UPLOAD_CERT_SHA256 = "5B:0E:AE:0C:1A:67:B6:3C:11:57:57:93:E3:C2:B4:CB:22:24:FD:A5:61:3C:4E:F0:0B:4B:14:EF:2B:08:ED:4A"
PLAY_SCOPE = "https://www.googleapis.com/auth/androidpublisher"
REPO_ROOT = File.expand_path("..", __dir__)

def command_output!(*command, chdir: nil)
  options = chdir ? { chdir: chdir } : {}
  stdout, stderr, status = Open3.capture3(*command, **options)
  return stdout if status.success?

  UI.user_error!("Command failed: #{command.map(&:shellescape).join(" ")}\n#{stderr.strip}")
end

def release_env!(name)
  value = ENV[name].to_s
  UI.user_error!("Set #{name} before release verification or upload") if value.empty?
  value
end

def verified_aab_sha256!
  value = release_env!("VERIFIED_AAB_SHA256").downcase
  UI.user_error!("VERIFIED_AAB_SHA256 must be a 64-character lowercase SHA-256 digest") unless value.match?(/\A[0-9a-f]{64}\z/)
  value
end

def aab_path!
  path = release_env!("RELEASE_AAB_PATH")
  UI.user_error!("RELEASE_AAB_PATH does not identify a readable AAB") unless File.file?(path) && File.readable?(path)
  path
end

def aapt2_path
  configured = ENV["AAPT2_PATH"]
  return configured if configured && File.executable?(configured)

  sdk_root = ENV["ANDROID_SDK_ROOT"] || ENV["ANDROID_HOME"]
  candidate = sdk_root && Dir.glob(File.join(sdk_root, "build-tools", "*", "aapt2")).max
  UI.user_error!("Set AAPT2_PATH or ANDROID_SDK_ROOT to an Android SDK containing aapt2") unless candidate && File.executable?(candidate)
  candidate
end

def aab_manifest_tree(aab)
  Dir.mktmpdir("easynotebook-aab") do |directory|
    manifest = File.join(directory, "AndroidManifest.xml")
    apk = File.join(directory, "manifest.apk")
    File.binwrite(manifest, command_output!("unzip", "-p", aab, "base/manifest/AndroidManifest.xml"))
    command_output!("zip", "-q", apk, "AndroidManifest.xml", chdir: directory)
    command_output!(aapt2_path, "dump", "xmltree", "--file", "AndroidManifest.xml", apk)
  end
end

def manifest_value(tree, name)
  tree[/#{name}.*Raw: "([^"]+)"/, 1]
end

def play_credentials_path
  path = ENV["PLAY_SERVICE_ACCOUNT_JSON"]
  UI.user_error!("Set PLAY_SERVICE_ACCOUNT_JSON to an ignored service-account JSON file") if path.to_s.empty?
  UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON does not identify a readable file") unless File.file?(path) && File.readable?(path)
  path
end

def verify_source!
  current_branch = command_output!("git", "branch", "--show-current", chdir: REPO_ROOT).strip
  unless ALLOWED_RELEASE_BRANCHES.include?(current_branch)
    UI.user_error!("Git branch is not approved for release verification: #{current_branch.inspect}")
  end
  unless command_output!("git", "status", "--porcelain", chdir: REPO_ROOT).strip.empty?
    UI.user_error!("Release verification requires a clean Git working tree")
  end

  expected_commit = release_env!("RELEASE_SOURCE_COMMIT")
  actual_commit = command_output!("git", "rev-parse", "HEAD", chdir: REPO_ROOT).strip
  UI.user_error!("Release source commit mismatch: expected #{expected_commit}, got #{actual_commit}") unless actual_commit == expected_commit
end

def verify_aab!
  aab = aab_path!
  expected_version_code = release_env!("RELEASE_VERSION_CODE")
  expected_version_name = release_env!("RELEASE_VERSION_NAME")

  actual_sha256 = Digest::SHA256.file(aab).hexdigest
  UI.user_error!("AAB SHA-256 mismatch: expected #{verified_aab_sha256!}, got #{actual_sha256}") unless actual_sha256 == verified_aab_sha256!

  signature = command_output!("jarsigner", "-verify", "-certs", aab)
  UI.user_error!("AAB signature verification did not report success") unless signature.include?("jar verified")

  certificate = command_output!("keytool", "-printcert", "-jarfile", aab)
  fingerprint = certificate[/SHA256:\s*([0-9A-F:]+)/i, 1]&.upcase
  UI.user_error!("Upload certificate SHA-256 mismatch") unless fingerprint == EXPECTED_UPLOAD_CERT_SHA256

  tree = aab_manifest_tree(aab)
  UI.user_error!("AAB applicationId mismatch") unless tree[/A: package="([^"]+)"/, 1] == APP_ID
  UI.user_error!("AAB versionCode mismatch") unless manifest_value(tree, "versionCode") == expected_version_code
  UI.user_error!("AAB versionName mismatch") unless manifest_value(tree, "versionName") == expected_version_name
  UI.user_error!("AAB unexpectedly enables android:debuggable") if tree.match?(/android:debuggable/)
  UI.user_error!("AAB unexpectedly enables android:testOnly") if tree.match?(/android:testOnly/)
end

platform :android do
  desc "Read-only fail-closed verification of a signed release AAB and clean source provenance"
  lane :verify_release do
    verify_source!
    verify_aab!
    UI.success("Verified #{APP_ID} #{release_env!("RELEASE_VERSION_NAME")} (#{release_env!("RELEASE_VERSION_CODE")}) AAB and upload certificate")
  end

  desc "Read-only Android Publisher API access check; it does not create an edit or upload an artifact"
  lane :validate_play_access do
    require "google/apis/androidpublisher_v3"
    require "googleauth"

    credentials = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(play_credentials_path),
      scope: PLAY_SCOPE
    )
    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
    service.authorization = credentials
    service.list_reviews(APP_ID, max_results: 1)
    UI.success("Google Play service account has read access to #{APP_ID}")
  end

  desc "Upload a pre-verified AAB only to Google Play Internal testing as a draft"
  lane :upload_internal do
    UI.user_error!("Set CONFIRM_INTERNAL_UPLOAD=YES to explicitly permit an Internal draft upload") unless ENV["CONFIRM_INTERNAL_UPLOAD"] == "YES"
    verify_release
    validate_play_access

    options = {
      package_name: APP_ID,
      json_key: play_credentials_path,
      aab: aab_path!,
      track: "internal",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
    mapping = ENV["RELEASE_MAPPING_PATH"]
    options[:mapping] = mapping if mapping && File.file?(mapping)
    upload_to_play_store(**options)
    UI.success("Internal draft upload completed. This lane cannot target Production.")
  end
end
